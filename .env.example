# Server-side opt-in gates. Credentials are supplied privately at deployment.
EMAIL_NOTIFICATIONS_ENABLED=false
AUTO_TRANSLATION_ENABLED=false
# Loads Google Tag Manager and/or PostHog for visitors who opt in to Usage analytics.
# Requires GTM_CONTAINER_ID or both PostHog values. PostHog server logs also need this flag.
ANALYTICS_ENABLED=false
# GTM_CONTAINER_ID=GTM-XXXXXXX
# PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Shows ratings and the Highest rated sort. Keep false until members can rate a recipe in the UI.
RATINGS_ENABLED=false
# Shows the English/Español switch in the header. Keep false until both languages are ready.
LANGUAGE_SWITCH_ENABLED=false
RESEND_DOMAIN_VERIFIED=false
# DATABASE_URL=
# PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# APP_ORIGIN=https://your-deployment.example
# Set true only after Clerk instance allows email-code signup/sign-in, with social/password/passkeys disabled.
CLERK_EMAIL_CODE_CONFIGURED=false
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# IMAGEKIT_PRIVATE_KEY=
# OWNER_BOOTSTRAP_EMAIL=

# Prevent accountless Clerk provisioning; keys must be supplied privately.
PUBLIC_CLERK_KEYLESS_DISABLED=true
PUBLIC_CLERK_TELEMETRY_DISABLED=true

# Media uploads are off unless a provider is chosen.
# local: development only (refused on Vercel and in production builds); files go to .media-local/.
# imagekit: also needs the keys below and MEDIA_LIVE_PROOF_PASSED set to the date
# scripts/media-proof.ts passed on the owner's account (see docs/operations/media-proof.md).
# MEDIA_PROVIDER=local
# MEDIA_LIVE_PROOF_PASSED=YYYY-MM-DD
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-private-endpoint
