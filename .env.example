# Server-side opt-in gates. Credentials are supplied privately at deployment.
EMAIL_NOTIFICATIONS_ENABLED=false
AUTO_TRANSLATION_ENABLED=false
ANALYTICS_ENABLED=false
RESEND_DOMAIN_VERIFIED=false
# DATABASE_URL=
# PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# APP_ORIGIN=https://your-deployment.example
# Set true only after Clerk instance allows email-code signup/sign-in, with social/password/passkeys disabled.
CLERK_EMAIL_CODE_CONFIGURED=false
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# IMAGEKIT_PRIVATE_KEY=
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_KEY=
# OWNER_BOOTSTRAP_EMAIL=

# Prevent accountless Clerk provisioning; keys must be supplied privately.
PUBLIC_CLERK_KEYLESS_DISABLED=true
PUBLIC_CLERK_TELEMETRY_DISABLED=true
