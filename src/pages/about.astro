---
import aboutHeirloomImg from '../assets/images/about_heirloom_cookbook_1794804777512.jpg';
import AboutStory from '../features/about/AboutStory';
import { readServerConfig } from '../server/config';
import AppLayout from '../layouts/AppLayout.astro';

const spanish = Astro.url.searchParams.get('lang') === 'es';
const language = spanish ? 'es' : 'en';

const { languageSwitchEnabled } = readServerConfig();
---
<AppLayout title={spanish ? 'Acerca de' : 'About'}>
  <AboutStory
    client:load
    language={language}
    heroImageUrl={aboutHeirloomImg.src}
    languageSwitchEnabled={languageSwitchEnabled}
  />
</AppLayout>
