---
import { ProfileFields, SavedListField } from '../features/accounts/ProfileFields';
import { Button } from '../components/ui/button';
import { Alert, AlertDescription } from '../components/ui/alert';
import { Card, CardContent } from '../components/ui/card';
import ImageUploader from '../features/media/ImageUploader';
import { mediaReadiness } from '../features/media/service';
import { isPreviewMode } from '../server/preview-store';
import AppLayout from '../layouts/AppLayout.astro';
import { accountConfiguration } from '../server/clerk';
import { accounts, type Actor } from '../features/accounts/service';
import { AccountError, assertSameOriginWrite, safeReturnTo, signInHref } from '../features/accounts/permissions';
import { accountFailure } from '../features/accounts/routes';
const spanish = Astro.url.searchParams.get('lang') === 'es';
const origin = accountConfiguration()?.origin ?? Astro.url.origin;
const target = safeReturnTo(Astro.url.searchParams.get('returnTo'), origin);
let actor: Actor | undefined;
let errorMessage = '';
if (Astro.request.method === 'POST') {
  try {
    assertSameOriginWrite(Astro.request, origin);
    const service = accounts();
    const form = await Astro.request.formData();
    await service.updateProfile(Astro.request, Object.fromEntries(form));
    return Astro.redirect(target, 303);
  } catch (error) {
    if (!(error instanceof AccountError && error.status === 400)) return accountFailure(error);
    Astro.response.status = 400;
    errorMessage = spanish ? 'Revisa tu nombre, biografía y avatar.' : 'Check your display name, bio and avatar.';
  }
}
try { actor = await accounts().requireActor(Astro.request); }
catch (error) {
  if (error instanceof AccountError && error.status === 401) return Astro.redirect(signInHref(target, origin), 303);
  return accountFailure(error);
}
---
<AppLayout title={spanish ? 'Tu perfil' : 'Your profile'}>
  <div class="flex max-w-3xl flex-col items-start gap-1.5">
    <p class="m-0 text-xs font-semibold tracking-wider text-primary-ink uppercase">{spanish ? 'Bienvenida a la familia' : 'Welcome to the family'}</p>
    <h1 class="m-0">{spanish ? 'Tu perfil' : 'Your profile'}</h1>
    <p class="intro m-0">{spanish ? 'Elige cómo aparecerás en la comunidad. Puedes cambiarlo después.' : 'Choose how you appear in the community. You can change this later.'}</p>
  </div>
  {errorMessage && <Alert variant="destructive" id="profile-error" className="mt-6 max-w-3xl"><AlertDescription><a href="#display-name">{errorMessage}</a></AlertDescription></Alert>}
  <Card className="mt-8 max-w-3xl border border-border shadow-xs">
    <CardContent>
      <form method="post" class="account-form" aria-describedby={errorMessage ? 'profile-error' : undefined}>
        <ProfileFields spanish={spanish} displayName={actor?.displayName} bio={actor?.bio} avatarPreset={actor?.avatarPreset} />
        <ImageUploader client:load purpose="avatar" available={mediaReadiness().enabled || isPreviewMode()} spanish={spanish} currentAssetId={actor?.avatarAssetId} />
        <SavedListField spanish={spanish} isPublic={actor?.savedListPublic} />
        <Button type="submit" className="justify-self-start">{spanish ? 'Guardar y continuar' : 'Save and continue'}</Button>
      </form>
    </CardContent>
  </Card>
</AppLayout>
