---
import AppLayout from '../layouts/AppLayout.astro';
import { accountConfiguration } from '../server/clerk';
import { accounts, type Actor } from '../features/accounts/service';
import { AccountError, assertSameOriginWrite, safeReturnTo, signInHref } from '../features/accounts/permissions';
import { accountFailure } from '../features/accounts/routes';
const spanish = Astro.url.searchParams.get('lang') === 'es';
const origin = accountConfiguration()?.origin ?? Astro.url.origin;
const target = safeReturnTo(Astro.url.searchParams.get('returnTo'), origin);
let actor: Actor | undefined;
let errorMessage = '';
if (Astro.request.method === 'POST') {
  try {
    assertSameOriginWrite(Astro.request, origin);
    const service = accounts();
    const form = await Astro.request.formData();
    await service.updateProfile(Astro.request, Object.fromEntries(form));
    return Astro.redirect(target, 303);
  } catch (error) {
    if (!(error instanceof AccountError && error.status === 400)) return accountFailure(error);
    Astro.response.status = 400;
    errorMessage = spanish ? 'Revisa tu nombre, biografía y avatar.' : 'Check your display name, bio and avatar.';
  }
}
try { actor = await accounts().requireActor(Astro.request); }
catch (error) {
  if (error instanceof AccountError && error.status === 401) return Astro.redirect(signInHref(target, origin), 303);
  return accountFailure(error);
}
---
<AppLayout title={spanish ? 'Tu perfil' : 'Your profile'}>
  <h1>{spanish ? 'Tu perfil' : 'Your profile'}</h1>
  <p class="intro">{spanish ? 'Elige cómo aparecerás en la comunidad. Puedes cambiarlo después.' : 'Choose how you appear in the community. You can change this later.'}</p>
  {errorMessage && <p role="alert" id="profile-error"><a href="#display-name">{errorMessage}</a></p>}
  <form method="post" class="account-form" aria-describedby={errorMessage ? 'profile-error' : undefined}>
    <label for="display-name">{spanish ? 'Nombre público (obligatorio)' : 'Display name (required)'}</label>
    <input id="display-name" name="displayName" required maxlength="80" autocomplete="nickname" value={actor?.displayName ?? ''} />
    <label for="bio">{spanish ? 'Biografía (opcional)' : 'Bio (optional)'}</label>
    <textarea id="bio" name="bio" maxlength="400" rows="4">{actor?.bio ?? ''}</textarea>
    <label for="avatar">{spanish ? 'Avatar' : 'Avatar'}</label>
    <select id="avatar" name="avatarPreset">
      <option value="" selected={!actor?.avatarPreset}>{spanish ? 'Mis iniciales' : 'My initials'}</option>
      <option value="chile" selected={actor?.avatarPreset === 'chile'}>{spanish ? 'Chile' : 'Chile pepper'}</option>
      <option value="corn" selected={actor?.avatarPreset === 'corn'}>{spanish ? 'Maíz' : 'Corn'}</option>
      <option value="lime" selected={actor?.avatarPreset === 'lime'}>{spanish ? 'Lima' : 'Lime'}</option>
    </select>
    <p id="favorites-privacy">{spanish ? 'Tus recetas guardadas son públicas por defecto. Elige Privadas para compartir solo tus recetas publicadas.' : 'Your saved recipes are public by default. Choose Private to share only your published recipes.'}</p>
    <label for="saved-list">{spanish ? 'Visibilidad de recetas guardadas' : 'Saved recipe visibility'}</label>
    <select id="saved-list" name="savedListPublic" aria-describedby="favorites-privacy"><option value="true" selected={actor?.savedListPublic !== false}>{spanish ? 'Públicas' : 'Public'}</option><option value="false" selected={actor?.savedListPublic === false}>{spanish ? 'Privadas' : 'Private'}</option></select>
    <button type="submit">{spanish ? 'Guardar y continuar' : 'Save and continue'}</button>
  </form>
</AppLayout>
