---
import AppLayout from '../../../layouts/AppLayout.astro';
import { buttonVariants } from '../../../components/ui/button';
import { Empty, EmptyDescription, EmptyHeader, EmptyTitle } from '../../../components/ui/empty';
import RecipeReader from '../../../features/recipes/RecipeReader';
import RecipeBackLink from '../../../features/recipes/RecipeBackLink';
import '../../../features/recipes/editor.css';
import { draftsService } from '../../../features/recipes/drafts';
import { catalogService, type PhotoCredit } from '../../../features/recipes/catalog';
import type { Origin } from '../../../features/recipes/validation';
import { favoriteService } from '../../../features/recipes/favorites';
import { optionalActor } from '../../../features/recipes/catalog-routes';
import { signInHref } from '../../../features/accounts/permissions';
import { accountConfiguration } from '../../../server/clerk';
import type { TranslatableText } from '../../../features/recipes/translation-text';
const spanish = Astro.url.searchParams.get('lang') === 'es';
const language = spanish ? 'es' : 'en';
Astro.response.headers.set('Cache-Control', 'private, no-store');
let recipe = null;
let failed = false;
try {
  const result = await draftsService().readPublished(Astro.params.id ?? '');
  if (result.ok) recipe = result.value;
  else failed = result.error.status === 503;
} catch { failed = true; }
if (!recipe) Astro.response.status = failed ? 503 : 404;
// Old or edited slugs redirect to the current URL; the stable id decides which recipe this is.
if (recipe && Astro.url.pathname !== recipe.url) return Astro.redirect(recipe.url! + (spanish ? '?lang=es' : ''), 308);
let origins: Origin[] = [];
let translation: TranslatableText | null = null;
let authorName: string | null = null;
let credit: { contributor: string | null; originalAuthor: string | null } | null = null;
let photoCredits: Record<string, PhotoCredit> = {};
let favorite = { favorited: false, count: 0, signedIn: false, signIn: '' };
if (recipe) {
  const catalog = catalogService();
  const viewer = await optionalActor(Astro.request).catch(() => null);
  favorite = { ...(await favoriteService().state(viewer?.id ?? null, recipe.id)), signedIn: viewer !== null, signIn: signInHref(`${recipe.url}?save=${recipe.id}${spanish ? '&lang=es' : ''}`, accountConfiguration()?.origin ?? Astro.url.origin) };
  [origins, translation, authorName, credit, photoCredits] = await Promise.all([
    draftsService().origins(),
    catalog.readerTranslation(recipe.id, language),
    catalog.authorName(recipe.ownerId ?? null),
    catalog.cookbookCredit(recipe.id),
    catalog.photoCredits(recipe.id),
  ]);
}
// Share card: the recipe's cover photo and the opening of its story, trimmed on a word boundary.
const cover = recipe?.input.photos[0];
const shareImage = recipe && cover ? {
  src: `/api/recipes/${recipe.id}/photos/${cover.assetId}?variant=gallery`,
  alt: cover.alt || cover.caption || recipe.input.title,
  type: 'image/webp',
} : undefined;
const story = recipe?.input.story.replace(/\s+/g, ' ').trim() ?? '';
const shareDescription = story.length > 160 ? `${story.slice(0, 157).replace(/\s+\S*$/, '')}…` : story || undefined;
const date = (iso: string) => new Intl.DateTimeFormat(language, { dateStyle: 'long' }).format(new Date(iso));
const t = spanish
  ? { cookbook: 'Del recetario Escalera', contributed: 'Aportada por', original: 'Receta original de', by: 'Por', published: 'Publicada', updated: 'Actualizada', gone: 'Uy, esta receta se ha ido de la mesa.', explore: 'Explorar recetas', unavailable: 'No pudimos cargar esta receta. Inténtalo de nuevo en un momento.' }
  : { cookbook: 'From the Escalera cookbook', contributed: 'Contributed by', original: 'Original recipe by', by: 'By', published: 'Published', updated: 'Updated', gone: 'Oops—this recipe has left the table.', explore: 'Explore Recipes', unavailable: 'We couldn’t load this recipe. Please try again in a moment.' };
---
<AppLayout title={recipe?.input.title ?? (spanish ? 'Receta no disponible' : 'Recipe unavailable')} description={shareDescription} image={shareImage} ogType={recipe ? 'article' : 'website'}>
  {recipe ? (
    <>
      <RecipeBackLink client:load language={language} />
      <RecipeReader client:load id={recipe.id} url={recipe.url!} input={recipe.input} origins={origins} language={language} translation={translation} credits={photoCredits} favorite={favorite}>
        <p slot="byline" class="m-0 mb-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted-foreground">
          {credit && <span>{t.cookbook}{credit.contributor && ` · ${t.contributed} ${credit.contributor}`}{credit.originalAuthor && ` · ${t.original} ${credit.originalAuthor}`}</span>}
          {authorName && <span>{t.by} <a href={`/members/${recipe.ownerId}${spanish ? '?lang=es' : ''}`}>{authorName}</a></span>}
          <span>{t.published}: <time datetime={recipe.publishedAt!}>{date(recipe.publishedAt!)}</time></span>
          <span>{t.updated}: <time datetime={recipe.updatedAt}>{date(recipe.updatedAt)}</time></span>
        </p>
      </RecipeReader>
    </>
  ) : (
    <Empty className="rounded-2xl border border-dashed border-border bg-card/70"><EmptyHeader>
      <EmptyTitle><h1>{failed ? t.unavailable : t.gone}</h1></EmptyTitle>
      <EmptyDescription><a href={spanish ? '/discover?lang=es' : '/discover'} data-slot="button" class={buttonVariants()}>{t.explore}</a></EmptyDescription>
    </EmptyHeader></Empty>
  )}
</AppLayout>
