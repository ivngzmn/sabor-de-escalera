---
import heroTableImg from '../assets/images/home_shared_table_1794804012275.jpg';
import AppLayout from '../layouts/AppLayout.astro';
import HomeShowcase from '../features/home/HomeShowcase';
import { catalogService, type RecipeCard } from '../features/recipes/catalog';
import { optionalActor } from '../features/recipes/catalog-routes';
import { draftsService } from '../features/recipes/drafts';
import type { Origin } from '../features/recipes/validation';
import { signInHref } from '../features/accounts/permissions';
import { accountConfiguration } from '../server/clerk';
import { readServerConfig } from '../server/config';

const spanish = Astro.url.searchParams.get('lang') === 'es';
const language = spanish ? 'es' : 'en';
// Favorite state is per viewer, so the page itself is never shared-cached.
Astro.response.headers.set('Cache-Control', 'private, no-store');

const ratingsEnabled = readServerConfig().ratingsEnabled;
let popular: RecipeCard[] = [];
let quick: RecipeCard[] = [];
let newest: RecipeCard[] = [];
let sweet: RecipeCard[] = [];
let origins: Origin[] = [];
let catalogHealthy = false;

try {
  const viewer = await optionalActor(Astro.request);
  const viewerId = viewer?.id ?? null;
  const service = catalogService();
  const [savedRes, quickRes, newestRes, dessertsRes, drinksRes, availableOrigins] = await Promise.all([
    service.list({ sort: 'saved', language }, viewerId),
    service.list({ maxMinutes: 60, sort: 'newest', language }, viewerId),
    service.list({ sort: 'newest', language }, viewerId),
    service.list({ category: 'desserts', sort: 'newest', language }, viewerId),
    service.list({ category: 'drinks', sort: 'newest', language }, viewerId),
    draftsService().origins(),
  ]);
  origins = availableOrigins;
  if (savedRes.ok) {
    catalogHealthy = true;
    popular = savedRes.value.items.slice(0, 6);
  }
  if (quickRes.ok) {
    catalogHealthy = true;
    quick = quickRes.value.items.slice(0, 6);
  }
  if (newestRes.ok) {
    catalogHealthy = true;
    newest = newestRes.value.items.slice(0, 6);
  }
  const dessertItems = dessertsRes.ok ? dessertsRes.value.items : [];
  const drinkItems = drinksRes.ok ? drinksRes.value.items : [];
  const seen = new Set<string>();
  sweet = [...dessertItems, ...drinkItems].filter((c) => (seen.has(c.id) ? false : (seen.add(c.id), true))).slice(0, 6);
} catch {
  catalogHealthy = false;
}

const signInBase = signInHref(`${Astro.url.pathname}${Astro.url.search}`, accountConfiguration()?.origin ?? Astro.url.origin);
---
<AppLayout title={spanish ? 'Inicio' : 'Home'}>
  <HomeShowcase
    client:load
    language={language}
    heroImageUrl={heroTableImg.src}
    popular={popular}
    quick={quick}
    newest={newest}
    sweet={sweet}
    catalogHealthy={catalogHealthy}
    origins={origins}
    signInBase={signInBase}
    ratingsEnabled={ratingsEnabled}
  />
</AppLayout>
