---
import AppLayout from '../layouts/AppLayout.astro';
const spanish = Astro.url.searchParams.get('lang') === 'es';
---
<AppLayout title={spanish ? 'Descubrir' : 'Discover'}>
  <p class="eyebrow">{spanish ? 'Nuestra mesa compartida' : 'Our shared table'}</p>
  <h1>{spanish ? 'Sabores que nos unen.' : 'Flavors that bring us together.'}</h1>
  <p class="intro">{spanish ? 'Un lugar para compartir recetas e historias, y cocinar juntos.' : 'A place to share recipes and stories, and cook together.'}</p>
  <section class="empty-state" aria-labelledby="recipes-heading">
    <h2 id="recipes-heading">{spanish ? 'Las recetas están en camino' : 'Recipes are on their way'}</h2>
    <p>{spanish ? 'Estamos preparando la colección. Las recetas aparecerán aquí después de su revisión.' : 'We’re preparing the collection. Recipes will appear here after review.'}</p>
  </section>
</AppLayout>
