---
import AppLayout from '../layouts/AppLayout.astro';
import { SignIn } from '@clerk/astro/components';
import { Badge } from '../components/ui/badge';
import { Card, CardContent } from '../components/ui/card';
import { accountConfiguration, ClerkResponseError } from '../server/clerk';
import { requireActor } from '../features/accounts/service';
import { AccountError, safeReturnTo } from '../features/accounts/permissions';
const spanish = Astro.url.searchParams.get('lang') === 'es';
const config = accountConfiguration();
const target = safeReturnTo(Astro.url.searchParams.get('returnTo'), config?.origin ?? Astro.url.origin);
const onboarding = `/onboarding?${new URLSearchParams({ returnTo: target, ...(spanish ? { lang: 'es' } : {}) })}`;
let available = Boolean(config);
if (config) {
  try {
    const actor = await requireActor(Astro.request);
    return Astro.redirect(actor.onboarded ? target : onboarding, 303);
  } catch (error) { if (error instanceof ClerkResponseError) return error.response; if (!(error instanceof AccountError && error.status === 401)) available = false; }
}
if (!available) Astro.response.status = 503;
// Clerk's widget follows the Stitch tokens (terracotta CTA, 8px radius, warm borders).
const appearance = {
  variables: { colorPrimary: '#c84b31', colorText: '#231a12', colorTextSecondary: '#58413c', colorBackground: '#ffffff', colorInputBackground: '#ffffff', borderRadius: '0.5rem', fontFamily: '"Plus Jakarta Sans", system-ui, sans-serif' },
  elements: { rootBox: 'w-full', cardBox: 'w-full shadow-none border-0', card: 'shadow-none border-0 p-0' },
};
---
<AppLayout title={spanish ? 'Iniciar sesión' : 'Sign in'}>
  <div class="grid items-start gap-8 lg:grid-cols-[1.1fr_1fr]">
    <section class="flex flex-col items-start gap-2 rounded-xl border border-border bg-muted p-6 md:p-10">
      <Badge variant="eyebrow">{spanish ? 'Nuestra mesa compartida' : 'Our shared table'}</Badge>
      <h1>{spanish ? 'Iniciar sesión' : 'Sign in'}</h1>
      <p class="intro">{spanish ? 'Usa tu correo electrónico y el código de verificación para compartir recetas y guardar favoritos.' : 'Use your email and verification code to share recipes and save favorites.'}</p>
      <figure class="m-0 mt-6 w-full rounded-xl bg-primary p-6 text-primary-foreground shadow-md">
        <blockquote class="m-0 font-serif text-2xl leading-snug">“{spanish ? 'Donde come uno, comen dos.' : 'Where one can eat, two can eat.'}”</blockquote>
        <figcaption class="type-label-sm mt-2 text-primary-foreground">{spanish ? 'Refrán tradicional' : 'Traditional proverb'}</figcaption>
      </figure>
    </section>
    <Card className="shadow-md">
      <CardContent className="flex flex-col gap-4">
        {available ? <SignIn routing="hash" withSignUp={true} forceRedirectUrl={onboarding} signUpForceRedirectUrl={onboarding} appearance={appearance} /> : <p role="status" class="m-0 text-muted-foreground">{spanish ? 'El inicio de sesión no está disponible temporalmente. Inténtalo más tarde.' : 'Sign-in is temporarily unavailable. Please try again later.'}</p>}
      </CardContent>
    </Card>
  </div>
</AppLayout>
