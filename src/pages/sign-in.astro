---
import AppLayout from '../layouts/AppLayout.astro';
import { SignIn } from '@clerk/astro/components';
import { Badge } from '../components/ui/badge';
import { buttonVariants } from '../components/ui/button';
import { Card, CardContent } from '../components/ui/card';
import { accountConfiguration, ClerkResponseError } from '../server/clerk';
import { isPreviewMode } from '../server/preview-store';
import { requireActor } from '../features/accounts/service';
import { AccountError, returningMemberTarget, safeReturnTo } from '../features/accounts/permissions';
const spanish = Astro.url.searchParams.get('lang') === 'es';
const config = accountConfiguration();
const previewMode = !config && isPreviewMode();
const target = safeReturnTo(Astro.url.searchParams.get('returnTo'), config?.origin ?? Astro.url.origin);
const onboarding = `/onboarding?${new URLSearchParams({ returnTo: target, ...(spanish ? { lang: 'es' } : {}) })}`;
let available = Boolean(config);
if (config) {
  try {
    const actor = await requireActor(Astro.request);
    return Astro.redirect(actor.onboarded ? returningMemberTarget(target, config.origin) : onboarding, 303);
  } catch (error) { if (error instanceof ClerkResponseError) return error.response; if (!(error instanceof AccountError && error.status === 401)) available = false; }
}
if (!available && !previewMode) Astro.response.status = 503;
const appearance = {
  variables: { colorPrimary: 'var(--primary)', colorText: 'var(--foreground)', colorTextSecondary: 'var(--muted-foreground)', colorBackground: 'var(--card)', colorInputBackground: 'var(--card)', colorInputText: 'var(--foreground)', borderRadius: 'var(--radius-control)', fontFamily: 'var(--font-body)', fontSize: '1rem' },
  elements: {
    rootBox: { width: '100%' },
    cardBox: { width: '100%', boxShadow: 'none', border: 0, overflow: 'visible' },
    card: { boxShadow: 'none', border: 0, padding: 0, margin: 0 },
    footer: { background: 'none' },
    formFieldLabel: { fontSize: '.875rem', fontWeight: 600 },
    formFieldInput: {
      minHeight: '2.75rem', paddingInline: '.75rem', backgroundColor: 'var(--card)', transition: 'border-color .15s, box-shadow .15s',
      '&[data-variant="default"], &[data-variant="default"]:hover': { border: '1px solid var(--input)', boxShadow: '0 1px 3px 0 rgba(30, 27, 22, .05)' },
      '&[data-variant="default"]:focus, &[data-variant="default"]:focus-within, &[data-variant="default"][data-focus-within="true"]': { outline: 'none', borderColor: 'var(--ring)', boxShadow: '0 0 0 3px color-mix(in srgb, var(--ring) 20%, transparent)' },
      '&[data-variant="default"][data-feedback="error"], &[data-variant="default"][data-feedback="error"]:focus-within': { borderColor: 'var(--destructive)', boxShadow: '0 0 0 3px color-mix(in srgb, var(--destructive) 20%, transparent)' },
    },
    formButtonPrimary: { minHeight: '2.75rem', backgroundImage: 'none', backgroundColor: 'var(--primary)', boxShadow: 'var(--shadow-level-1)', fontSize: '.875rem', fontWeight: 600, textTransform: 'none', '&::after': { display: 'none' }, '&:hover': { backgroundColor: 'var(--primary-hover)' } },
  },
};
---
<AppLayout title={spanish ? 'Iniciar sesión' : 'Sign in'}>
  <div class="grid items-start gap-8 lg:grid-cols-[1.1fr_1fr]">
    <section class="flex flex-col items-start gap-2 rounded-xl border border-border bg-muted p-6 md:p-10">
      <Badge variant="eyebrow">{spanish ? 'Nuestra mesa compartida' : 'Our shared table'}</Badge>
      <h1>{spanish ? 'Iniciar sesión' : 'Sign in'}</h1>
      <p class="intro">{spanish ? 'Usa tu correo electrónico y el código de verificación para compartir recetas y guardar favoritos.' : 'Use your email and verification code to share recipes and save favorites.'}</p>
      <figure class="m-0 mt-6 w-full rounded-xl bg-primary p-6 text-primary-foreground shadow-sm">
        <blockquote class="m-0 type-headline-lg text-primary-foreground">“{spanish ? 'Donde come uno, comen dos.' : 'Where one can eat, two can eat.'}”</blockquote>
        <figcaption class="type-label-sm mt-2 text-primary-foreground/90">{spanish ? 'Refrán tradicional' : 'Traditional proverb'}</figcaption>
      </figure>
    </section>
    <Card className="shadow-sm">
      <CardContent className="flex flex-col gap-4">
        {available ? (
          <SignIn routing="hash" withSignUp={true} forceRedirectUrl={onboarding} signUpForceRedirectUrl={onboarding} appearance={appearance} />
        ) : previewMode ? (
          <div class="flex flex-col items-start gap-4">
            <h2 class="type-headline-sm m-0">{spanish ? 'Modo de vista previa' : 'Community preview'}</h2>
            <p class="m-0 text-sm text-muted-foreground">
              {spanish
                ? 'Explora y edita recetas, guarda favoritos y prueba la revisión del recetario con la cuenta de ejemplo.'
                : 'Browse and edit recipes, save favorites, and try cookbook review with the preview member account.'}
            </p>
            <button
              type="button"
              data-slot="button"
              class={buttonVariants()}
              data-preview-signin
              data-target={target}
            >
              {spanish ? 'Continuar como Elena Morales' : 'Continue as Elena Morales'}
            </button>
            <script is:inline>
              (() => {
                const btn = document.querySelector('[data-preview-signin]');
                if (!btn) return;
                btn.addEventListener('click', () => {
                  document.cookie = 'preview_session=; Max-Age=0; path=/; SameSite=Lax';
                  window.location.assign(btn.getAttribute('data-target') || '/');
                });
              })();
            </script>
          </div>
        ) : (
          <p role="status" class="m-0 text-muted-foreground">{spanish ? 'El inicio de sesión no está disponible temporalmente. Inténtalo más tarde.' : 'Sign-in is temporarily unavailable. Please try again later.'}</p>
        )}
      </CardContent>
    </Card>
  </div>
</AppLayout>
