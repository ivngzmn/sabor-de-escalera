---
import { ArrowLeftIcon } from '@radix-ui/react-icons';
import AppLayout from '../../../layouts/AppLayout.astro';
import { Badge } from '../../../components/ui/badge';
import ReadinessTrack from '../../../features/cookbook/ReadinessTrack';
import { checks, flagLabel, missingLabel, readiness, summarize } from '../../../features/cookbook/labels';
import { cookbookQueue, type QueueFilter } from '../../../features/cookbook/queue';
import BulkApprove from '../../../features/translations/BulkApprove';
import { translationService } from '../../../features/translations/service';
import { adminOrResponse } from './_guard';
Astro.response.headers.set('Cache-Control', 'private, no-store');
const actor = await adminOrResponse(Astro.request, Astro.url);
if (actor instanceof Response) return actor;
const requested = Astro.url.searchParams.get('filter');
const filter: QueueFilter = requested === 'eligible' || requested === 'blocked' ? requested : 'all';
// One query for every view, so the tab counts and the book summary always agree.
const queue = await cookbookQueue().listQueue(actor, 'all');
if (!queue.ok) Astro.response.status = queue.error.status;
const all = queue.ok ? queue.value : [];
const summary = summarize(all);
const views: Record<QueueFilter, typeof all> = {
  all,
  eligible: all.filter((r) => r.state !== 'published' && r.eligible),
  blocked: all.filter((r) => r.state !== 'published' && !r.eligible),
};
const rows = views[filter];
const proposals = await translationService().listProposals(actor);
const waiting = proposals.ok ? proposals.value.length : 0;
const tabs: [QueueFilter, string][] = [['all', 'All recipes'], ['blocked', 'Needs work'], ['eligible', 'Ready to publish']];
const share = (n: number) => (summary.total ? `${(n / summary.total) * 100}%` : '0%');
// Show the first few blockers in plain words; the entry page lists them all.
const needed = (missing: string[]) => missing.filter((m) => !['text-review', 'image-review'].includes(m)).map(missingLabel);
---
<AppLayout title="Cookbook review">
  <a href="/admin" class="mb-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary-ink no-underline hover:underline"><ArrowLeftIcon aria-hidden="true" />Administration</a>
  <div class="flex max-w-3xl flex-col gap-2">
    <h1 class="m-0">Cookbook review</h1>
    <p class="intro m-0">Every recipe from the book waits here unpublished until its details, photos and credits are complete and both reviews are done. Being in the book is not permission to reuse its text or photos on the web.</p>
  </div>

  {queue.ok && (
    <section aria-labelledby="book-progress" class="mt-8 flex flex-col gap-4 rounded-xl bg-card p-5 shadow-sm sm:p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <h2 id="book-progress" class="type-headline-sm m-0">{summary.published} of {summary.total} recipes published</h2>
        <p class="m-0 text-sm text-muted-foreground">{summary.ready} ready to publish, {summary.blocked} still need work</p>
      </div>
      <div aria-hidden="true" class="flex h-3 overflow-hidden rounded-full bg-muted">
        <span class="bg-secondary" style={`width:${share(summary.published)}`}></span>
        <span class="bg-masa" style={`width:${share(summary.ready)}`}></span>
      </div>
      <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0 text-sm text-muted-foreground" aria-label="Legend">
        <li class="inline-flex items-center gap-2"><span aria-hidden="true" class="size-2.5 rounded-full bg-secondary"></span>Published</li>
        <li class="inline-flex items-center gap-2"><span aria-hidden="true" class="size-2.5 rounded-full bg-masa"></span>Ready to publish</li>
        <li class="inline-flex items-center gap-2"><span aria-hidden="true" class="size-2.5 rounded-full border border-input bg-muted"></span>Needs work</li>
      </ul>
    </section>
  )}

  {waiting > 0 ? (
    <section aria-labelledby="pending-translations" class="mt-6 flex flex-col gap-3 rounded-xl border border-masa/40 bg-masa-soft p-5">
      <h2 id="pending-translations" class="type-headline-sm m-0">{waiting} {waiting === 1 ? 'translation is' : 'translations are'} waiting for approval</h2>
      {proposals.ok && <BulkApprove client:load proposals={proposals.value} />}
    </section>
  ) : !proposals.ok ? <p role="alert" class="mt-6">{proposals.error.message}</p> : null}

  <section aria-labelledby="staged-recipes" class="mt-10 flex flex-col gap-4">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="staged-recipes" class="m-0">Recipes</h2>
      <nav aria-label="Filter recipes" class="flex flex-wrap gap-1 rounded-xl bg-muted p-1">
        {tabs.map(([value, label]) => (
          <a
            href={value === 'all' ? '/admin/cookbook' : `/admin/cookbook?filter=${value}`}
            aria-current={value === filter ? 'page' : undefined}
            class:list={['inline-flex min-h-10 items-center gap-2 rounded-lg px-3 text-sm font-semibold no-underline', value === filter ? 'bg-card text-foreground shadow-sm' : 'text-muted-foreground hover:text-foreground']}
          >{label}<span class="rounded-full bg-background px-2 text-xs tabular-nums">{views[value].length}</span></a>
        ))}
      </nav>
    </div>
    <p class="m-0 text-sm text-muted-foreground">Each recipe shows four checks: {checks.map((c) => c.label).join(', ')}.</p>

    {!queue.ok ? <p role="alert">{queue.error.message}</p> : rows.length === 0 ? (
      <p class="rounded-xl border border-dashed border-input/60 p-6 text-muted-foreground">{filter === 'eligible' ? 'Nothing is ready to publish yet. Open a recipe to fill in what it needs.' : 'No recipes in this view.'}</p>
    ) : (
      <ul class="m-0 flex list-none flex-col gap-2 p-0">
        {rows.map((r) => {
          const left = needed(r.missing);
          return (
            <li class="relative grid gap-3 rounded-xl bg-card p-4 shadow-xs transition-shadow focus-within:ring-[3px] focus-within:ring-ring hover:shadow-md md:grid-cols-[minmax(0,1.6fr)_auto_minmax(0,1.4fr)] md:items-center md:gap-6">
              <div class="flex min-w-0 flex-col gap-1">
                <a href={`/admin/cookbook/${r.entryId}`} class="font-serif text-lg leading-snug text-foreground no-underline after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{r.title}</a>
                <span class="text-sm text-muted-foreground">
                  {r.pages.length > 1 ? 'Pages' : 'Page'} {r.pages.join('–')}{r.contributor ? `, contributed by ${r.contributor}` : ''}
                </span>
              </div>
              {r.state === 'published'
                ? <Badge variant="tag" className="justify-self-start">Published</Badge>
                : <ReadinessTrack readiness={readiness(r)} compact />}
              <div class="flex min-w-0 flex-wrap items-center gap-1.5 text-sm">
                {r.state === 'published' ? null : r.eligible ? <span class="font-semibold text-secondary">Ready to publish</span> : (
                  <>
                    {left.slice(0, 3).map((label) => <span class="rounded-full bg-muted px-2.5 py-0.5">{label}</span>)}
                    {left.length > 3 && <span class="text-muted-foreground">and {left.length - 3} more</span>}
                    {left.length === 0 && <span class="text-muted-foreground">Waiting for review</span>}
                  </>
                )}
                {r.flags.length > 0 && <span class="ml-auto text-xs text-muted-foreground" title={r.flags.map(flagLabel).join('\n')}>{r.flags.length} {r.flags.length === 1 ? 'note' : 'notes'} from transcription</span>}
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</AppLayout>
