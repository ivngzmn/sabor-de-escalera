---
import AppLayout from '../../layouts/AppLayout.astro';
import { SignIn } from '@clerk/astro/components';
import { accounts, type Actor } from '../../features/accounts/service';
import { accountConfiguration, ClerkResponseError } from '../../server/clerk';
import { AccountError, safeReturnTo } from '../../features/accounts/permissions';
import { accountFailure } from '../../features/accounts/routes';
const spanish = Astro.url.searchParams.get('lang') === 'es';
const config = accountConfiguration();
let actor: Actor | undefined;
let available = Boolean(config);
let management: Awaited<ReturnType<ReturnType<typeof accounts>['listAdministrators']>> | undefined;
let audit: Awaited<ReturnType<ReturnType<typeof accounts>['readAudit']>> = [];
if (config) {
  try {
    const service = accounts();
    actor = await service.requireAdmin(Astro.request);
    if (!actor.onboarded) return Astro.redirect(`/onboarding?${new URLSearchParams({ returnTo: spanish ? '/admin?lang=es' : '/admin', ...(spanish ? { lang: 'es' } : {}) })}`, 303);
    if (actor.role === 'owner') { management = await service.listAdministrators(Astro.request); audit = await service.readAudit(Astro.request); }
  } catch (error) {
    if (error instanceof ClerkResponseError) return error.response;
    if (error instanceof AccountError && error.status === 403) return accountFailure(error);
    if (!(error instanceof AccountError && error.status === 401)) available = false;
  }
}
if (!actor && !available) Astro.response.status = 503;
const target = safeReturnTo(Astro.url.searchParams.get('returnTo') ?? (spanish ? '/admin?lang=es' : '/admin'), config?.origin ?? Astro.url.origin);
const onboarding = `/onboarding?${new URLSearchParams({ returnTo: target, ...(spanish ? { lang: 'es' } : {}) })}`;
---
<AppLayout title={actor ? (spanish ? 'Administración' : 'Administration') : (spanish ? 'Acceso administrativo' : 'Admin sign-in')}>
  <h1>{actor ? (spanish ? 'Administración' : 'Administration') : (spanish ? 'Acceso administrativo' : 'Admin sign-in')}</h1>
  {!actor && (available ? <SignIn routing="hash" withSignUp={true} forceRedirectUrl={onboarding} signUpForceRedirectUrl={onboarding} /> : <p role="status">{spanish ? 'El inicio de sesión no está disponible temporalmente. Inténtalo más tarde.' : 'Sign-in is temporarily unavailable. Please try again later.'}</p>)}
  {actor && <p>{spanish ? `Hola, ${actor.displayName}.` : `Welcome, ${actor.displayName}.`}</p>}
  {management && <section aria-labelledby="admin-roles">
    <h2 id="admin-roles">{spanish ? 'Administradores' : 'Administrators'}</h2>
    <form method="post" action="/api/accounts/admin" class="account-form">
      <input type="hidden" name="action" value="invite" /><input type="hidden" name="lang" value={spanish ? 'es' : 'en'} />
      <label for="invite-email">{spanish ? 'Correo del administrador' : 'Administrator email'}</label><input id="invite-email" name="email" type="email" autocomplete="email" required />
      <p>{spanish ? 'La invitación dura siete días. El acceso se concede cuando inicie sesión con ese correo verificado. Comparte el enlace /admin; los correos de notificación están desactivados.' : 'The invitation lasts seven days. Access is granted when they sign in with that verified email. Share the /admin link; notification emails are disabled.'}</p>
      <button type="submit">{spanish ? 'Crear invitación' : 'Create invitation'}</button>
    </form>
    <ul>{management.invitations.map((invite) => <li><form method="post" action="/api/accounts/admin"><input type="hidden" name="action" value="revoke" /><input type="hidden" name="target" value={invite.id} /><input type="hidden" name="lang" value={spanish ? 'es' : 'en'} /><span>{invite.email}</span> <button type="submit">{spanish ? 'Revocar invitación' : 'Revoke invitation'}</button></form></li>)}</ul>
    <ul>{management.members.map((member) => <li><form method="post" action="/api/accounts/admin"><input type="hidden" name="action" value="remove" /><input type="hidden" name="target" value={member.id} /><input type="hidden" name="lang" value={spanish ? 'es' : 'en'} /><span>{member.display_name ?? (spanish ? 'Perfil pendiente' : 'Profile pending')}</span> <button type="submit">{spanish ? 'Retirar acceso administrativo' : 'Remove admin access'}</button></form></li>)}</ul>
    <h2>{spanish ? 'Registro de cambios de acceso' : 'Access change audit'}</h2>
    <ul>{audit.map((event) => <li><time datetime={event.created_at.toISOString()}>{event.created_at.toLocaleDateString(spanish ? 'es' : 'en')}</time> · {event.action} · {event.target_id}</li>)}</ul>
  </section>}
</AppLayout>
