---
import { ArrowLeftIcon } from '@radix-ui/react-icons';
import AppLayout from '../../../layouts/AppLayout.astro';
import TranslationEditor from '../../../features/translations/TranslationEditor';
import { accounts } from '../../../features/accounts/service';
import { AccountError, signInHref } from '../../../features/accounts/permissions';
import { accountFailure } from '../../../features/accounts/routes';
import { translationService } from '../../../features/translations/service';
import { accountConfiguration, ClerkResponseError } from '../../../server/clerk';
Astro.response.headers.set('Cache-Control', 'private, no-store');
const origin = accountConfiguration()?.origin ?? Astro.url.origin;
let actor;
try { actor = await accounts().requireAdmin(Astro.request); }
catch (error) {
  if (error instanceof ClerkResponseError) return error.response;
  if (error instanceof AccountError && error.status === 401) return Astro.redirect(signInHref(Astro.url.pathname, origin, true), 303);
  return accountFailure(error);
}
const review = await translationService().readForReview(actor, Astro.params.recipeId ?? '');
if (!review.ok) Astro.response.status = review.error.status;
const source = review.ok ? review.value.input : null;
const target = source?.language === 'es' ? 'en' : 'es';
const rows = review.ok ? review.value.translations.filter((t) => t.language === target) : [];
const proposed = rows.find((t) => t.status === 'proposed') ?? null;
const approved = rows.find((t) => t.status === 'approved') ?? null;
---
<AppLayout title="Translation review">
  <a href="/admin/cookbook" class="mb-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary-ink no-underline hover:underline"><ArrowLeftIcon aria-hidden="true" />Cookbook review</a>
  {review.ok && source ? (
    <>
      <div class="flex max-w-3xl flex-col gap-2">
        <h1 class="m-0">{source.title || 'Untitled recipe'}</h1>
        <p class="intro m-0">{target === 'es' ? 'Spanish' : 'English'} translation, written by hand from the {source.language === 'es' ? 'Spanish' : 'English'} original. Readers see it only after it’s approved, and it goes out of date whenever the recipe changes.</p>
      </div>
      <div class="mt-8 rounded-xl bg-card p-5 shadow-sm sm:p-8">
        <TranslationEditor client:load recipeId={Astro.params.recipeId!} source={source} version={review.value.version} target={target} proposed={proposed} approved={approved} />
      </div>
    </>
  ) : <h1>{review.ok ? 'Recipe not found' : review.error.message}</h1>}
</AppLayout>
