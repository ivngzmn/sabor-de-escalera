---
import '../styles/global.css';
import '../styles/tokens.css';
import headingFont from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import bodyFont from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import bodyStrongFont from '@fontsource/dm-sans/files/dm-sans-latin-600-normal.woff2?url';
import ConsentBanner from '../features/consent/ConsentBanner';
import { Cross1Icon, HamburgerMenuIcon } from '@radix-ui/react-icons';
import { buttonVariants } from '../components/ui/button';
import { readServerConfig } from '../server/config';
import { accountConfiguration } from '../server/clerk';
import { hasSessionHint, readHeaderIdentity } from '../server/header-identity';
import { isPreviewMode } from '../server/preview-store';
import AccountMenu from '../features/accounts/AccountMenu';
import { signInHref } from '../features/accounts/permissions';

interface Props { title: string; privacySettings?: boolean; }
const { title } = Astro.props;
const { languageSwitchEnabled, gtmContainerId } = readServerConfig();
const language = Astro.url.searchParams.get('lang') === 'es' ? 'es' : 'en';
const copy = language === 'es'
  ? { skip: 'Saltar al contenido', menu: 'Menú', home: 'Inicio', discover: 'Descubrir', add: 'Añadir receta', favorites: 'Favoritos', about: 'Acerca de', footer: 'Recetas, historias y sabores para compartir.' }
  : { skip: 'Skip to content', menu: 'Menu', home: 'Home', discover: 'Discover', add: 'Add Recipe', favorites: 'Favorites', about: 'About', footer: 'Recipes, stories, and flavors to share.' };
const href = (path: string) => language === 'es' ? `${path}?lang=es` : path;
const languageHref = (value: string) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set('lang', value);
  return `${Astro.url.pathname}?${params.toString()}`;
};
Astro.response.headers.set('Cache-Control', 'private, no-store');
const authEnabled = accountConfiguration() !== null;
const previewMode = !authEnabled && isPreviewMode();
const accountHref = signInHref(`${Astro.url.pathname}${Astro.url.search}`, Astro.url.origin);
const showAccount = !/^\/(?:sign-in|onboarding)(?:\/|$)/.test(Astro.url.pathname);
const sessionHint = authEnabled && hasSessionHint(Astro.request);
const initialMe = showAccount && (sessionHint || previewMode) ? await readHeaderIdentity(Astro.request) : null;
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.footer} />
    <meta name="theme-color" content="#fbf8f3" />
    {[headingFont, bodyFont, bodyStrongFont].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
    ))}
    <title>{title} · Sabor de Escalera</title>
    {gtmContainerId && <meta name="escalera:gtm" content={gtmContainerId} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link" data-en="Skip to content" data-es="Saltar al contenido">{copy.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href('/')}>Sabor de Escalera</a>
        <div id="site-menu" class="site-menu">
          <nav class="site-nav" aria-label={language === 'es' ? 'Navegación principal' : 'Main navigation'}>
            <a href={href('/')} aria-current={Astro.url.pathname === '/' ? 'page' : undefined} data-en="Home" data-es="Inicio">{copy.home}</a>
            <a href={href('/discover')} aria-current={Astro.url.pathname === '/discover' ? 'page' : undefined} data-en="Discover" data-es="Descubrir">{copy.discover}</a>
            <a href={href('/favorites')} aria-current={Astro.url.pathname === '/favorites' || (Astro.url.pathname === '/profile' && Astro.url.searchParams.get('tab') === 'favorites') ? 'page' : undefined} data-en="Favorites" data-es="Favoritos">{copy.favorites}</a>
            <a href={href('/about')} aria-current={Astro.url.pathname === '/about' ? 'page' : undefined} data-en="About" data-es="Acerca de">{copy.about}</a>
            <a href={href('/add-recipe')} data-slot="button" class={`${buttonVariants({ size: 'sm' })} whitespace-nowrap`} aria-current={Astro.url.pathname === '/add-recipe' ? 'page' : undefined} data-en="Add Recipe" data-es="Añadir receta">{copy.add}</a>
          </nav>
          {languageSwitchEnabled && (
            <nav class="language-switch" aria-label={language === 'es' ? 'Idioma' : 'Language'}>
              <a href={languageHref('en')} lang="en" hreflang="en" aria-current={language === 'en' ? 'true' : undefined}>English</a>
              <a href={languageHref('es')} lang="es" hreflang="es" aria-current={language === 'es' ? 'true' : undefined}>Español</a>
            </nav>
          )}
        </div>
        <div class="header-actions">
          {showAccount && ((authEnabled || previewMode) ? <AccountMenu client:load authEnabled={authEnabled} previewMode={previewMode} sessionHint={sessionHint} initialMe={initialMe} language={language} signInHref={accountHref} /> : <a href={accountHref} data-slot="button" class={buttonVariants({ variant: 'outline' })}>{language === 'es' ? 'Iniciar sesión' : 'Sign in'}</a>)}
          <button type="button" data-slot="button" class={`menu-toggle ${buttonVariants({ variant: 'ghost', size: 'icon' })}`} aria-label={copy.menu} aria-expanded="false" aria-controls="site-menu">
            <HamburgerMenuIcon className="menu-open-icon size-5" aria-hidden="true" />
            <Cross1Icon className="menu-close-icon size-5" aria-hidden="true" />
          </button>
        </div>
      </div>
    </header>
    <script is:inline>
      (() => {
        const header = document.querySelector('.site-header');
        const toggle = header?.querySelector('.menu-toggle');
        if (!header || !toggle) return;
        const setOpen = (open) => { header.dataset.menu = open ? 'open' : 'closed'; toggle.setAttribute('aria-expanded', String(open)); };
        setOpen(false);
        toggle.addEventListener('click', () => setOpen(header.dataset.menu !== 'open'));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && header.dataset.menu === 'open') { setOpen(false); toggle.focus(); }
        });
      })();
    </script>
    <script>
      import { registerConsentCleanup, readConsent, subscribeConsent } from '../features/consent/service';
      import { startTagManager } from '../features/consent/tag-manager';
      const containerId = document.querySelector<HTMLMetaElement>('meta[name="escalera:gtm"]')?.content;
      if (containerId) startTagManager(containerId, { readConsent, subscribe: subscribeConsent, registerCleanup: registerConsentCleanup });
    </script>
    <main id="main-content" tabindex="-1" class="container"><slot /></main>
    {!Astro.props.privacySettings && <ConsentBanner client:load language={language} />}
    <footer class="site-footer">
      <div class="container">
        <div class="footer-inner">
          <div class="footer-brand">
            <p class="brand">Sabor de Escalera</p>
            <p class="footer-copy">{copy.footer}</p>
          </div>
          <nav class="footer-nav" aria-label={language === 'es' ? 'Navegación del pie de página' : 'Footer navigation'}>
            <a href={href('/')} data-en="Home" data-es="Inicio">{copy.home}</a>
            <a href={href('/discover')} data-en="Discover" data-es="Descubrir">{copy.discover}</a>
            <a href={href('/favorites')} data-en="Favorites" data-es="Favoritos">{copy.favorites}</a>
            <a href={href('/about')} data-en="About" data-es="Acerca de">{copy.about}</a>
            <a href={href('/add-recipe')} data-en="Add Recipe" data-es="Añadir receta">{copy.add}</a>
          </nav>
        </div>
        <p class="footer-legal">© {new Date().getFullYear()} Sabor de Escalera</p>
      </div>
    </footer>
  </body>
</html>
